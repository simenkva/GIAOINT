	$(MAKE) $(MAKESILENT) -f CMakeFiles/giao_integrals_core.dir/build.make CMakeFiles/giao_integrals_core.dir/src/types.cpp.s
.PHONY : src/types.cpp.s

tests/cpp/test_overlap.o: tests/cpp/test_overlap.cpp.o
.PHONY : tests/cpp/test_overlap.o

# target to build an object file
tests/cpp/test_overlap.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/giao_cpp_tests.dir/build.make CMakeFiles/giao_cpp_tests.dir/tests/cpp/test_overlap.cpp.o
.PHONY : tests/cpp/test_overlap.cpp.o

tests/cpp/test_overlap.i: tests/cpp/test_overlap.cpp.i
.PHONY : tests/cpp/test_overlap.i

# target to preprocess a source file
tests/cpp/test_overlap.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/giao_cpp_tests.dir/build.make CMakeFiles/giao_cpp_tests.dir/tests/cpp/test_overlap.cpp.i
.PHONY : tests/cpp/test_overlap.cpp.i

tests/cpp/test_overlap.s: tests/cpp/test_overlap.cpp.s
.PHONY : tests/cpp/test_overlap.s

# target to generate assembly for a file
tests/cpp/test_overlap.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/giao_cpp_tests.dir/build.make CMakeFiles/giao_cpp_tests.dir/tests/cpp/test_overlap.cpp.s
.PHONY : tests/cpp/test_overlap.cpp.s

